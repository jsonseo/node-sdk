{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "declaration": true,
    // Сборка идёт только через tsconfig.build.json и tsconfig.cjs.json:
    // без этого голый `tsc` разложил бы .js и .d.ts прямо рядом с
    // исходниками, где они тихо устаревают.
    "noEmit": true,
    "removeComments": false
  },
  "include": ["src"]
}
